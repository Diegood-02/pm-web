# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

# Base de datos (PostgreSQL)
POSTGRES_USER=pm
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=pm_web
DATABASE_URL=postgresql+psycopg://pm:cambia-esta-clave@db:5432/pm_web

# Autenticación (JWT). Genera una clave larga y aleatoria para cada entorno.
JWT_SECRET_KEY=cambia-por-una-clave-aleatoria-larga
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# CORS: orígenes permitidos separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Zona horaria por defecto para proyectos nuevos (ISO 8601 en la API)
DEFAULT_TIMEZONE=America/Mexico_City

# Red: por defecto los servicios solo escuchan en este equipo (127.0.0.1).
# Pon 0.0.0.0 para publicarlos en la red del piloto.
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
VITE_API_URL=http://localhost:8000/api/v1

# Límites y seguridad
MAX_REQUEST_BYTES=2000000
MAX_TASKS_PER_PROJECT=5000
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# Logs: DEBUG, INFO, WARNING o ERROR
LOG_LEVEL=INFO
