{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pm-web.local/schemas/project/v1",
  "title": "Proyecto PM Web (formato 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "project", "resources", "tasks", "dependencies", "assignments"],
  "properties": {
    "format": { "const": "pm-web-project" },
    "schema_version": { "const": 1 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "start_date"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
        "start_date": { "type": "string", "format": "date" },
        "working_weekdays": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 6 }
        },
        "hours_per_day": { "type": "number", "exclusiveMinimum": 0, "maximum": 24 },
        "holidays": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "date" } },
        "extra_working_days": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "date" } }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "name"],
        "properties": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 40 },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "max_units": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "hourly_rate": { "type": "number", "minimum": 0 }
        }
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "name", "duration_days"],
        "properties": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 40 },
          "parent_ref": { "type": ["string", "null"], "maxLength": 40 },
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "duration_days": { "type": "integer", "minimum": 0, "maximum": 100000 },
          "is_milestone": { "type": "boolean" },
          "fixed_cost": { "type": "number", "minimum": 0 },
          "actual_cost": { "type": "number", "minimum": 0 },
          "percent_complete": { "type": "integer", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predecessor_ref", "successor_ref"],
        "properties": {
          "predecessor_ref": { "type": "string", "minLength": 1, "maxLength": 40 },
          "successor_ref": { "type": "string", "minLength": 1, "maxLength": 40 },
          "type": { "enum": ["FS", "SS", "FF", "SF"] },
          "lag_days": { "type": "integer", "minimum": -100000, "maximum": 100000 }
        }
      }
    },
    "assignments": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_ref", "resource_ref", "units_percent"],
        "properties": {
          "task_ref": { "type": "string", "minLength": 1, "maxLength": 40 },
          "resource_ref": { "type": "string", "minLength": 1, "maxLength": 40 },
          "units_percent": { "type": "integer", "minimum": 1, "maximum": 1000 }
        }
      }
    }
  }
}
